{
  "name": "openclaw-render",
  "version": "2.0.1",
  "private": true,
  "description": "OpenClaw on Render, pinned and hardened for main JimmyBrAin",
  "scripts": {
    "dev": "docker compose up --build",
    "dev:stop": "docker compose down",
    "dev:clean": "docker compose down -v",
    "dev:logs": "docker compose logs -f",
    "dev:shell": "docker compose exec openclaw bash",
    "test": "npm run verify:watchdog-patch",
    "verify:watchdog-patch": "node scripts/verify-watchdog-patch.js"
  },
  "dependencies": {
    "@chrysb/alphaclaw": "0.9.36",
    "openclaw": "2026.9.5"
  },
  "overrides": {
    "openclaw": "2026.9.5"
  },
  "engines": {
    "node": ">=24.16.0 <25 || >=26.1.0"
  }
}
